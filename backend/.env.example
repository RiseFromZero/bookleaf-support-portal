# Database: Local SQLite by default (no psycopg2 needed locally)
DATABASE_URL=sqlite:///./bookleaf.db

# JWT Security Configuration
JWT_SECRET_KEY=replace-with-secure-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Free Open-Source LLM Configuration (Groq Cloud OpenAI-Compatible API)
LLM_API_KEY=your_free_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant